{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            }
        },
        "logLevel": {
            "default": "Information",
            "Function": "Debug"
        }
    },
    "extensionBundle": {
        "id": "Microsoft.Azure.Functions.ExtensionBundle",
        "version": "[4.0.0, 5.0.0)"
    },
    "extensions": {
        "eventHubs": {
            "maxEventBatchSize": 128,
            "prefetchCount": 256,
            "batchCheckpointFrequency": 1,
            "targetUnprocessedEventThreshold": 1000
        }
    },
    "managedDependency": {
        "enabled": false
    }
}